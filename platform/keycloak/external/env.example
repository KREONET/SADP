# 외부 Keycloak VM 전용 입력값. 이 파일을 .env 로 복사해 채운다.
# .env 는 절대 커밋하지 않는다. 비밀번호는 openssl rand -hex 32 로 생성한다.

# Keycloak VM에서 DNS 조회와 UDP 123 응답이 모두 가능한 NTP 서버만 적는다.
# 공백으로 여러 서버를 구분한다. 원격 수렴은 NTPSynchronized=yes가 아니면 중단된다.
SADP_NTP_SERVERS="<INTERNAL_NTP_1> <INTERNAL_NTP_2>"

# 클러스터와 같은 공개 hostname. issuer 가 여기서 나온다.
# contracts/platform-production.yaml 의 keycloak.issuer 와 반드시 일치해야 한다.
KC_HOSTNAME=https://sso.CHANGE_ME.example.com

# Envoy 가 클러스터를 나올 때의 source 대역. 보통 노드 내부망 CIDR 이다.
# 여러 개면 쉼표로 구분한다.
KC_PROXY_TRUSTED_ADDRESSES=10.0.10.0/24

# Keycloak HTTP 를 노출할 VM 내부 NIC 주소. 공인 NIC 주소를 쓰지 않는다.
# 이 값이 contracts 의 keycloak.external.address 와 같아야 한다.
KEYCLOAK_BIND_ADDRESS=10.0.10.60

# identity provider(SAML/OIDC) metadata 를 가져오려면 밖으로 나가야 한다. 내부망 VM 은
# 보통 Squid 만 통하므로 http://SQUID_INTERNAL_IP:SQUID_PORT 를 적는다. 프록시 없이 직접
# 나갈 수 있는 사이트만 비워 둔다. 도메인 허용은 계약의 keycloak.identityProvider 호스트를
# 보고 render-network.py 가 Squid ACL 에 이미 넣어 둔다.
EGRESS_PROXY_URL=http://10.0.10.11:3128
# 프록시를 거치면 안 되는 대상. 쉼표로 구분하고 loopback 은 반드시 남긴다.
# CIDR 이 아니라 hostname/주소 목록이다.
EGRESS_NO_PROXY=localhost,127.0.0.1

KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=CHANGE_ME_RANDOM_HEX

KC_ADMIN_USER=kc-admin
KC_ADMIN_PASSWORD=CHANGE_ME_RANDOM_HEX

# 계약 spec.keycloak의 realm/identityProvider.alias/portalClientID와 같은 값이다.
# 일회성 compose job이 신규·기존 연합 사용자 developer 수렴과 Portal SLO를 구성한다.
KEYCLOAK_REALM=CHANGE_ME_REALM
KEYCLOAK_IDP_ALIAS=CHANGE_ME_IDP_ALIAS
KEYCLOAK_SAML_SP_ENTITY_ID=https://sso.CHANGE_ME.example.com/realms/CHANGE_ME_REALM
KEYCLOAK_IDP_METADATA_URL=https://idp.CHANGE_ME.example.com/metadata
KEYCLOAK_IDP_SSO_URL=https://idp.CHANGE_ME.example.com/sso
PORTAL_CLIENT_ID=CHANGE_ME_PORTAL_CLIENT_ID
PORTAL_POST_LOGOUT_REDIRECT_URI=https://CHANGE_ME.example.com/portal
