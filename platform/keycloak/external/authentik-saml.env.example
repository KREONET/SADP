# 외부 Authentik SAML Provider 수렴용 Private 입력 예시. 실제 값은 Git에 넣지 않는다.
AUTHENTIK_API_URL=https://authentik.CHANGE_ME.example.com
AUTHENTIK_API_TOKEN_FILE=/etc/sadp/credentials/authentik-api-token
AUTHENTIK_SAML_PROVIDER_ID=CHANGE_ME_POSITIVE_INTEGER
# 내부 CA를 쓰는 경우에만 설정한다. TLS 검증을 끄는 옵션은 지원하지 않는다.
# AUTHENTIK_API_CA_FILE=/etc/sadp/pki/authentik-ca.crt
