# 외부 SSO와 Keycloak VM 시간 비교용 Private 입력 예시. 실제 값은 Git에 넣지 않는다.
SAML_IDP_SSH_HOST=<EXTERNAL_SSO_HOST>
SAML_IDP_SSH_USER=root
SAML_IDP_SSH_PORT=22
# 선택. 기본 SSH agent/key를 쓰면 비워 둔다.
SAML_IDP_SSH_IDENTITY_FILE=
# 초 단위 비교의 fail-close 상한. 수정 전/후에는 --measure로 같은 기준을 사용한다.
# Assertion 검사 완화값이 아니다.
SAML_MAX_CLOCK_DELTA_SECONDS=5
# Keycloak VM의 journal 또는 Docker log를 자동 선택한다.
KEYCLOAK_LOG_RUNTIME=auto
