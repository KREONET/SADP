update-sadp|bash|scripts/ops/update-sadp.sh|GitHub main의 VERSION 확인 후 fast-forward 업데이트
rotate-forgejo-token|bash|scripts/ops/rotate-forgejo-token.sh|Forgejo 봇 토큰 회전
rotate-machine-api-key|bash|scripts/ops/rotate-machine-api-key.sh|기계 API 키 병행 반영·승격·폐기
unseal-openbao|bash|scripts/ops/unseal-openbao.sh|OpenBao seal 상태 plan, --apply에서만 root-only 재료로 unseal
ops-bundle|python3|scripts/ops/build-ops-bundle.py|Secret 제외 control-plane 운영 overlay와 checksum 생성
export-credentials|bash|scripts/ops/export-test-credentials.sh|자격증명을 Git 밖 root-only 경로로
GROUP:check — 커밋 전에 통과시킬 것
guard|bash|scripts/ci-guard.sh|금지 입력 차단. pre-commit과 CI가 같은 것을 쓴다
render-test|bash|scripts/tests/render-test.sh|helm template 회귀
test|special|test|회귀 시험 전부 + guard + render-test
TABLE
)

usage() {
  cat <<'EOF'
SADP 설치 명령어

  bash ./sadp --<명령> [옵션...]

옵션은 그대로 대상 스크립트에 전달됩니다.
  bash ./sadp --install --env-file /etc/sadp/site.env --phase render
  sudo bash ./sadp --install --env-file /etc/sadp/site.env --phase node --apply
  sudo bash ./sadp --install --env-file /etc/sadp/site.env --phase cluster --apply

root 승격은 하지 않습니다. 필요한 명령은 sudo를 직접 넣어야 합니다.
옮긴 스크립트를 직접 부르는 것도 계속 동작합니다(python3 scripts/site/render-network.py).

EOF
  list_commands
  cat <<'EOF'
EOF
}

list_commands() {
  local line group command runner path description
  while IFS= read -r line; do
    [[ -n ${line} ]] || continue
    if [[ ${line} == GROUP:* ]]; then
      printf '\n  \033[1m%s\033[0m\n' "${line#GROUP:}"
      continue
    fi
    IFS='|' read -r command runner path description <<<"${line}"
    printf '    --%-26s %s\n' "${command}" "${description}"
  done <<<"${COMMANDS}"
}

# 회귀 시험 묶음. AGENTS.md 3절의 목록과 같은 것을 돌린다.
run_test_suite() {
  local failed=0 script
  for script in scripts/tests/*-test.py; do
    printf '\n=== %s ===\n' "${script}"
    python3 "${script}" || failed=1
  done
  printf '\n=== scripts/tests/render-test.sh ===\n'
  bash scripts/tests/render-test.sh || failed=1
  printf '\n=== scripts/ci-guard.sh ===\n'
  bash scripts/ci-guard.sh || failed=1
  printf '\n=== git diff --check ===\n'
  git diff --check || failed=1
  if ((failed)); then
    printf '\n[FAIL] 회귀 시험 실패\n' >&2
    return 1
  fi
  printf '\n[OK]   회귀 시험 전부 통과\n'
}

# 계약을 고친 뒤 하위 생성물을 다시 만드는 순서.
run_render_all() {
  local script
  for script in render-network render-exposure render-rancher render-quota; do
    printf '=== %s ===\n' "${script}"
    python3 "scripts/site/${script}.py" "$@"
  done
}

resolve() {
  local want=$1 line command runner path description
  while IFS= read -r line; do
    [[ -n ${line} && ${line} != GROUP:* ]] || continue
    IFS='|' read -r command runner path description <<<"${line}"
    if [[ ${command} == "${want}" ]]; then
      printf '%s\t%s' "${runner}" "${path}"
      return 0
    fi
  done <<<"${COMMANDS}"
  return 1
}

if (($# == 0)); then
  usage
  exit 0
fi

case "$1" in
  -h|--help) usage; exit 0 ;;
  --list) list_commands; exit 0 ;;
esac

if [[ $1 != --* ]]; then
  printf '[FAIL] 명령은 --로 시작해야 한다: %s\n' "$1" >&2
  printf '       사용 가능한 명령은 bash ./sadp --list\n' >&2
  exit 2
fi

requested=${1#--}
shift

if ! resolved=$(resolve "${requested}"); then
  printf '[FAIL] 알 수 없는 명령: --%s\n' "${requested}" >&2
  printf '       사용 가능한 명령은 bash ./sadp --list\n' >&2
  exit 2
fi
IFS=$'\t' read -r runner target <<<"${resolved}"

case "${runner}" in
  special)
    case "${target}" in
      test) run_test_suite ;;
      render-all) run_render_all "$@" ;;
      *) printf '[FAIL] 내부 오류: 알 수 없는 special %s\n' "${target}" >&2; exit 2 ;;
    esac
    ;;
  python3|bash)
    [[ -f ${target} ]] || { printf '[FAIL] 대상 스크립트가 없다: %s\n' "${target}" >&2; exit 2; }
    exec "${runner}" "${target}" "$@"
    ;;
  *)
    printf '[FAIL] 내부 오류: 알 수 없는 실행기 %s\n' "${runner}" >&2
    exit 2
    ;;
esac
