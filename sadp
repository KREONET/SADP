#!/usr/bin/env bash
# SADP 공개 단일 진입점 dispatcher.
#
# scripts/ 아래 40개가 넘는 파일 이름을 외우지 않아도 되게 하는 얇은 dispatcher다.
# 여기서 하는 일은 "명령 -> 실제 스크립트" 매핑과 인자 전달뿐이고, 로직은 전부 대상
# 스크립트에 있다. 그래서 진입점에 문제가 생겨도 대상 스크립트를 직접 부르면 된다.
#
#   bash ./sadp --list
#   bash ./sadp --render-network
#   sudo bash ./sadp --install --env-file /etc/sadp/site.env --phase cluster --apply
#
# root 승격은 하지 않는다. sudo가 필요한 명령은 대상 스크립트의 require_root가
# 판단하게 두고, 이 파일이 몰래 권한을 올리지 않는다.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
cd "${ROOT}"

# 명령|실행기|경로|설명 (그룹은 GROUP: 줄로 나눈다)
COMMANDS=$(
