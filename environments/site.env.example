# SADP site configuration template.
#
# Copy this file outside Git (for example /etc/sadp/site.env), replace every
# *.example.invalid endpoint and documentation IP, then run:
#   python3 scripts/site/configure-site.py --env-file /etc/sadp/site.env --check
#
# This file contains only non-secret configuration and Kubernetes Secret *names*.
# Never add passwords, API tokens, private keys, kubeconfig, RKE2 join tokens, or
# Forgejo/Registry credentials here.

# -----------------------------------------------------------------------------
# Site and public hostnames
# -----------------------------------------------------------------------------
SITE_NAME=sadp
APP_ENVIRONMENT=prod
CLUSTER_NAME=sadp-production
# example.invalid과 아래 192.0.2.0/24·203.0.113.0/24 주소는 문서 전용이다.
# 통합 설치기는 이 값이 남은 상태에서 --apply를 거부한다.
BASE_DOMAIN=sadp.example.invalid
APP_PROJECT=research
# These names are site-specific too. They must not retain testbed beta names on
# a production cluster. Derived Rancher projects are proj-<namespace>.
WORKLOAD_NAMESPACE=sadp-apps
PLATFORM_ROUTE_NAMESPACE=sadp-platform
GATEWAY_NAMESPACE=envoy-gateway-system
GATEWAY_NAME=sadp-gateway
GATEWAY_PROXY_CONFIG_NAME=sadp-envoy-proxy
GATEWAY_ADDRESS_POOL_NAME=sadp-envoy-vip
WILDCARD_TLS_SECRET=sadp-wildcard-tls
ACME_CLUSTER_ISSUER_NAME=sadp-dns01
ACME_ACCOUNT_SECRET_NAME=sadp-acme-account-key
# 비우면 portal.<BASE_DOMAIN>. Portal만 BASE_DOMAIN 자체(apex)도 사용할 수 있다.
PORTAL_HOST=
HELLO_HOST=
SECURE_DEMO_HOST=
RANCHER_HOST=
OPENBAO_HOST=
# 용도별 도메인 분리(전용 Namespace/Rancher Project/wildcard 인증서). 형식은
# <name>=<domain>, 쉼표 구분, 도메인은 BASE_DOMAIN 의 서브도메인. 비우면 단일 도메인 구성.
# 예: SYSTEMS=analytics=analytics.example.com,bio=bio.example.com
# 인증은 아래 외부 identity provider 하나를 공유한다. 자세한 내용은
# docs/site-configuration.md와 docs/identity-provider.md 참고.
SYSTEMS=

# 클러스터 밖 VM 서비스(Forgejo, Grafana 등)를 같은 wildcard 인증서로 Envoy Gateway 뒤에 붙인다.
# 형식은 <name>=<IPv4>:<port>, 쉼표 구분. 공개 host는 <name>.<BASE_DOMAIN>.
# 예: EXTERNAL_SERVICES=forgejo=10.0.10.25:3000,grafana=10.0.10.26:3000
# 자세한 내용은 docs/site-configuration.md 5절 참고.
EXTERNAL_SERVICES=

# 브라우저 로그인이 안 되는 기계 클라이언트(외부 Grafana/Wazuh 등)의 인증 방식을 고른다.
# oidc는 외부 IdP의 client_credentials JWT, api-key는 OpenBao에 자동 생성한 클라이언트별
# X-SADP-API-Key를 쓴다. 사람용 브라우저 SSO와는 독립된 설정이다.
MACHINE_AUTH_MODE=oidc
# 자세한 입력과 키 전달/회전 절차는 docs/external-observability.md 참고.
# 예: MACHINE_AUTH_SERVICES=metrics=monitoring/prometheus-server:80,logs=monitoring/loki:3100
MACHINE_AUTH_SERVICES=
# oidc 모드에서는 토큰의 client ID claim과 비교할 client ID, api-key 모드에서는 키를 만들 client 이름.
# client secret이나 API 키 실제 값은 절대 넣지 않는다.
MACHINE_AUTH_CLIENTS=
# 외부 기계 클라이언트 출발지 IPv4 CIDR. 0.0.0.0/0 은 거부.
MACHINE_AUTH_ALLOWED_CIDRS=

# SADP는 IdP/realm/client/사용자/그룹을 설치하거나 자동 설정하지 않는다.
# openid: 외부 OpenID Connect IdP에 직접 연결한다.
# saml: 외부에서 관리하는 SAML→OIDC 브로커를 거친다. SADP가 소비하는 면은 항상 OIDC다.
IDENTITY_SOURCE_PROTOCOL=openid
OIDC_ISSUER=https://idp.example.invalid/application/o/sadp/
OIDC_AUTHORIZATION_ENDPOINT=https://idp.example.invalid/application/o/authorize/
OIDC_TOKEN_ENDPOINT=https://idp.example.invalid/application/o/token/
OIDC_JWKS_URI=https://idp.example.invalid/application/o/sadp/jwks/
# IdP가 RP-Initiated Logout을 제공하지 않으면 비운다.
OIDC_END_SESSION_ENDPOINT=
OIDC_GROUPS_CLAIM=groups
OIDC_CLIENT_ID_CLAIM=azp
PORTAL_OIDC_CLIENT_ID=sadp-portal
STORAGE_CLASS=local-path
# Compose named volume은 이 플랫폼 계약값으로만 PVC를 만든다. 요청마다 임의 용량이나
# StorageClass를 받지 않으며, Namespace quota는 size × max services로 생성된다.
APP_GROUP_VOLUME_SIZE=5Gi
APP_GROUP_MAX_SERVICES=5

# -----------------------------------------------------------------------------
# Forgejo GitOps repository and OCI/container Registry
# Values are endpoints and Secret names only. Credentials are registered later
# in Argo CD and Kubernetes through an approved Secret/OpenBao/ESO path.
# -----------------------------------------------------------------------------
FORGEJO_REPO_URL=https://forgejo.example.invalid/example/sadp.git
FORGEJO_REVISION=main
OCI_REGISTRY=registry.example.invalid
OCI_PROJECT=example/sadp
REGISTRY_PULL_SECRET=forgejo-registry-pull
TEST_APP_IMAGE_TAG=1111111111111111111111111111111111111111
PORTAL_IMAGE_TAG=2222222222222222222222222222222222222222
IMAGE_PULL_POLICY=IfNotPresent

# -----------------------------------------------------------------------------
# RKE2 node identity and internal network
# WORKER_NODES is comma-separated hostname=IPv4. Hostnames/IPs must be unique.
# Kubernetes/RKE2 identity always uses this internal interface and addresses.
# -----------------------------------------------------------------------------
# single은 서버 1대와 빈 WORKER_NODES, multi는 서버 1대와 워커 N대(N >= 1)를 쓴다.
CLUSTER_MODE=multi
CONTROL_PLANE_HOSTNAME=sadp-control-plane-1
CONTROL_PLANE_IP=10.20.30.11
WORKER_NODES=sadp-worker-1=10.20.30.21,sadp-worker-2=10.20.30.22
# `ip -br link`, `ip -br -4 address`, `ip -4 route`로 실제 이름을 확인해 적는다.
# 이 이름은 RKE2 Canal의 flannel.iface, 노드 identity, firewall에 함께 렌더된다.
# 현재 계약은 모든 노드가 같은 이름을 쓰므로 노드마다 다르면 systemd.link로 이름을 통일한다.
INTERNAL_INTERFACE=eth0
EXTERNAL_INTERFACE=eth1
# 계약상 역할이 없지만 공인 주소를 받을 수 있어 관리 포트를 차단해야 하는 NIC을 CSV로 적는다.
# INTERNAL/EXTERNAL_INTERFACE는 넣을 수 없다. 자세한 내용은 docs/network-egress.md 참고.
GUARDED_INTERFACES=
# NIC MAC은 여기 넣지 않는다(노드마다 달라서 site.env 값이 될 수 없음). 필요하면 각 노드에서
# install-rke2-network-identity.sh --internal-mac/--external-mac 으로 넘긴다.
# 자세한 내용은 docs/network-egress.md 참고.
NODE_INTERNAL_CIDRS=10.20.30.0/24
# 아래 세 값은 계약·NetworkPolicy뿐 아니라 rke/control-node/config.yaml의 RKE2 server
# 설정으로도 렌더된다. 클러스터를 만든 뒤 바꾸는 마이그레이션 입력이 아니므로 최초 설치 전에
# 실제 RKE2 Pod/Service 대역과 DNS Service IP를 확정하고, 기존 클러스터에서는 일치 여부만 확인한다.
POD_CIDRS=10.52.0.0/16
SERVICE_CIDRS=10.53.0.0/16
CLUSTER_DNS_IP=10.53.0.10
# Where CoreDNS forwards names it does not serve. Leave empty to use the node's
# /etc/resolv.conf. Set it when worker nodes have no direct egress, so CoreDNS
# does not inherit a resolver it cannot reach (every external name SERVFAILs).
# Must be inside NODE_INTERNAL_CIDRS, like SQUID_INTERNAL_IP -- an internal network
# on public address space is still valid. Open the listener on that host with
# scripts/node/install-dns-forwarder.sh.
CLUSTER_UPSTREAM_DNS=10.20.30.11:53
KUBERNETES_API_ADDRESSES=10.53.0.1,10.20.30.11
RKE2_SERVER_ENDPOINT=10.20.30.11

# Explicit internal firewall contract. These are the reviewed RKE2/Canal ports:
# etcd client/peer, Kubernetes API, RKE2 supervisor, kubelet, and Squid (TCP),
# plus Canal VXLAN (UDP). The generator rejects omission of a required port.
INTERNAL_ALLOWED_TCP_PORTS=2379,2380,6443,9345,10250,3128
INTERNAL_ALLOWED_UDP_PORTS=8472
KUBERNETES_API_PORT=6443
RKE2_SUPERVISOR_PORT=9345
ETCD_CLIENT_PORT=2379
ETCD_PEER_PORT=2380
KUBELET_PORT=10250
CANAL_VXLAN_UDP_PORT=8472

# -----------------------------------------------------------------------------
# Public/service network
# Only 80/443 are accepted. Kubernetes API/RKE2/etcd/kubelet are blocked on this
# interface by the interface guard and the upstream firewall.
# -----------------------------------------------------------------------------
PUBLIC_IP=203.0.113.10
# nat: 경계 장비가 PUBLIC_IP:80/443을 GATEWAY_VIP로 DNAT한다.
# direct: PUBLIC_IP가 EXTERNAL_INTERFACE에 직접 할당되고 Envoy Service externalIPs로 공개된다.
#
# 고르는 법은 취향이 아니라 사실 확인이다. 노드에서 아래를 실행해라.
#   ip -brief addr | grep <PUBLIC_IP>
# 나오면 direct 다. 그 주소를 노드가 들고 있으니 DNAT 해 줄 경계 장비가 존재하지 않는다.
# 안 나오면 nat 이고, 경계 장비에 80/443 DNAT 과 hairpin NAT 을 요청해야 한다.
#
# 틀리면 증상이 똑같이 "브라우저 연결 거부"로 나오므로 원인을 찾기 어렵다. 실제로
# direct 인데 nat 으로 적으면 렌더러가 Envoy Service 에 공인 IP 를 넣지 않아 그 주소의
# 80/443 에 아무것도 바인딩되지 않고 TCP RST 가 돌아온다(방화벽 차단이면 시간 초과다).
#
# direct 는 원본 client IP를 CIDR 정책에 쓰기 위해 externalTrafficPolicy: Local을 쓴다.
# Local은 공인 IP 노드에 Ready Envoy endpoint가 없으면 트래픽을 DROP하므로 그 노드의
# kubernetes.io/hostname 값을 PUBLIC_IP_NODE에 정확히 적어 Pod를 함께 고정한다.
PUBLIC_EXPOSURE_MODE=nat
# nat에서는 비운다. direct에서는 PUBLIC_IP를 실제로 가진 노드의 Kubernetes 이름이 필수다.
PUBLIC_IP_NODE=
GATEWAY_VIP=10.20.30.200
GATEWAY_ADDRESS_POOL=10.20.30.200-10.20.30.220
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
EXTERNAL_ALLOWED_TCP_PORTS=80,443
EXTERNAL_ALLOWED_UDP_PORTS=
# Envoy Service targetPort observed after installation; used by Canal policy.
ENVOY_HTTPS_TARGET_PORT=10443

# -----------------------------------------------------------------------------
# Squid egress
# Package endpoints already live in the platform contract. Add only extra exact
# hostnames here; no URL paths, wildcards, credentials, or general Internet ACL.
# -----------------------------------------------------------------------------
SQUID_INTERNAL_IP=10.20.30.11
SQUID_PORT=3128
SQUID_CLIENT_CIDRS=10.20.30.0/24,10.52.0.0/16
# 코드의 공통 package allowlist 외에 사이트가 추가로 쓰는 정확한 hostname만 적는다.
EXTRA_PACKAGE_DOMAINS=

# -----------------------------------------------------------------------------
# Let's Encrypt DNS-01 wildcard certificate
# Let's Encrypt는 CA일 뿐 DNS를 갱신하지 않는다. 이 저장소는 RFC2136/TSIG만 쓴다.
# 자세한 내용(모드 선택, 위임 절차, 예시)은 docs/letsencrypt-dns01.md 참고.
# -----------------------------------------------------------------------------
TLS_SOURCE=acme
# 아래 세 값은 설정이 아니라 "지금까지 끝낸 단계"의 기록이다. 순서대로만 올린다.
#   1) staging 발급 확인   -> ACME_STAGING_VERIFIED=true
#   2) 운영 발급 전환      -> TLS_ISSUER_MODE=production
#   3) 운영 인증서 Ready   -> EXISTING_GATEWAY_TLS_READY=true
# 3번이 true 여야 계약의 routeListener 가 https 가 되고 Gateway 에 HTTPS listener 와
# http->https redirect 가 생긴다. 클러스터는 이미 HTTPS 인데 이 값들만 뒤처져 있으면
# configure-site.py --write 가 계약을 과거로 되돌려 앱 route 를 http 로 내려버린다.
TLS_ISSUER_MODE=staging
ACME_STAGING_VERIFIED=false
EXISTING_GATEWAY_TLS_READY=false
ACME_EMAIL=admin@example.invalid
DNS_PROVIDER=rfc2136
# direct-rfc2136: DNS 관리자가 BASE_DOMAIN 전체의 TSIG를 직접 준다(ACME_DELEGATION_TYPE/
# ACME_DELEGATED_ZONE은 비움). delegated-rfc2136(기본): 관리자가 TSIG는 안 주고
# _acme-challenge만 우리 NS로 위임한다(관리자는 NS 레코드 한 줄만 추가).
DNS01_MODE=direct-rfc2136
# delegated-rfc2136 전용. direct-rfc2136이면 둘 다 비움(값이 남아 있으면 거부).
#   cname -> ACME_DELEGATED_ZONE은 우리가 운영하는 zone.
#   ns    -> ACME_DELEGATED_ZONE은 _acme-challenge.<BASE_DOMAIN> 고정.
ACME_DELEGATION_TYPE=
ACME_DELEGATED_ZONE=
# ns 호스트명이 아니라 그 호스트의 IPv4를 넣는다(cert-manager egress NetworkPolicy가
# <ip>/32로 생성되어 이름을 못 씀). UPDATE 경로(cert-manager -> BIND) 주소이며, Let's
# Encrypt가 검증 때 쓰는 공인 53과는 별개다(그쪽은 인터넷에 열려 있어야 함).
RFC2136_NAMESERVER=192.0.2.53:53
RFC2136_TSIG_KEY_NAME=acme-key.sadp.example.invalid.
RFC2136_TSIG_ALGORITHM=HMACSHA256
# The TSIG secret itself never lives in Git or in this file. It is delivered as
# a Kubernetes Secret (OpenBao + External Secrets Operator) under this name/key.
DNS_CREDENTIAL_SECRET_NAME=dns01-rfc2136-tsig
DNS_CREDENTIAL_SECRET_KEY=tsig-secret
# Resolver used for the DNS-01 self-check. It must return the public authoritative
# answer for _acme-challenge. Point it at the authoritative server when the cluster
# resolver cannot reach the public internet or shadows the zone (split-horizon).
DNS_RECURSIVE_NAMESERVERS=10.53.0.10:53
# any | control-plane. direct-rfc2136 sends raw DNS UPDATE from the cert-manager
# controller Pod, which Squid cannot proxy. Set control-plane when only the egress
# gateway node can reach the authoritative nameserver on port 53.
CERT_MANAGER_NODE_PLACEMENT=any
# Used only with TLS_SOURCE=provided; PEM bytes remain outside Git.
PROVIDED_CERTIFICATE_PATH=wildcard/fullchain.pem
PROVIDED_PRIVATE_KEY_PATH=wildcard/privkey.pem

# -----------------------------------------------------------------------------
# Integrated installer controls
# Secret 본문은 넣지 않고 root만 읽을 수 있는 파일의 절대경로만 지정한다.
# 각 노드에서 `sudo bash ./sadp --install --env-file /etc/sadp/site.env --phase node --apply`,
# control-plane에서 node 재시작 확인 후 `--phase cluster --apply`를 실행한다.
# cluster phase는 Devtron/번들 Argo CD가 완전히 없을 때 versions.lock 고정 버전으로 자동 설치한다.
# 수동으로 먼저 준비할 때만 `sudo bash ./sadp --install-devtron [--apply]`를 사용한다.
# -----------------------------------------------------------------------------
SADP_INSTALL_GITOPS=true
SADP_ARGO_REPO_USERNAME=sadp-installer
SADP_ARGO_REPO_TOKEN_FILE=/etc/sadp/secrets/forgejo-read-token
SADP_DNS_TSIG_SECRET_FILE=/etc/sadp/secrets/rfc2136-tsig
# false이면 monitoring chart/image 준비를 건너뛴다. 이때 monitoring Namespace backend를
# MACHINE_AUTH_SERVICES에 요청하면 configure/render 단계에서 실패한다.
SADP_INSTALL_MONITORING=true
SADP_BUILD_IMAGES=true
# 비우면 Ready·비-cordon worker 중 여유 메모리가 가장 큰 노드를 자동 선택한다.
SADP_BUILD_NODE=
SADP_DEPLOY_APPS=true
SADP_REGISTRY_PULL_DOCKERCONFIG=/etc/sadp/secrets/registry-pull-dockerconfig.json
SADP_REGISTRY_PUSH_DOCKERCONFIG=/etc/sadp/secrets/registry-push-dockerconfig.json
SADP_RUN_VERIFY=true
